// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Rust",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteUser": "vscode",
	// Delete the container (and everything written to its filesystem) when it
	// stops. Only the "mounts" below persist; VS Code creates a fresh container
	// from the existing image on next open.
	"runArgs": ["--rm"],
	"postCreateCommand": "git config core.hooksPath hooks",
	"remoteEnv": {
		"GH_TOKEN": "${localEnv:GH_TOKEN}",
		// Claude Code login: a long-lived token from `claude setup-token`,
		// exported in the Mac's shell profile. (Sharing .credentials.json
		// through a symlinked volume doesn't work: Claude Code replaces the
		// symlink with a regular file when it saves.)
		"CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
	},
	"mounts": [
		// This repo's Claude sessions, history and settings.
		{
			"source": "${localWorkspaceFolderBasename}-devcontainer-claude-config",
			"target": "/home/vscode/.claude",
			"type": "volume"
		},
		// Bind the host git config so name/email survive rebuilds. SSH keys are
		// not mounted: VS Code forwards the host SSH agent into the container
		// automatically, so the key never leaves the host.
		{
			"source": "${localEnv:HOME}/.gitconfig",
			"target": "/home/vscode/.gitconfig",
			"type": "bind"
		}
	]
}
