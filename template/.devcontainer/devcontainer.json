// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "__PROJECT_NAME__",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteUser": "vscode",
	// Delete the container (and everything written to its filesystem) when it
	// stops. Only the "mounts" below persist; VS Code creates a fresh container
	// from the existing image on next open.
	"runArgs": ["--rm"],
	// `|| true`: the folder may not be a git repo yet; runs again on every open.
	"postCreateCommand": "git config core.hooksPath hooks 2>/dev/null || true",
	"remoteEnv": {
		"GH_TOKEN": "${localEnv:GH_TOKEN}",
		// Claude Code login, shared by every project: a long-lived token from
		// `claude setup-token`, exported in the Mac's shell profile. (Sharing
		// .credentials.json through a symlinked volume doesn't work: Claude
		// Code replaces the symlink with a regular file when it saves.)
		"CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
	},
	"containerEnv": {
		// The workspace is bind-mounted through virtiofs (Docker Desktop's Mac
		// file sharing), which intermittently fails heavily parallel cargo
		// builds with "Bad address (os error 14)". Building inside the
		// container's own filesystem avoids that, and the build output is
		// deleted along with the container.
		"CARGO_TARGET_DIR": "/home/vscode/cargo-target",
		// Full debug info is most of a debug target/'s size; line tables keep
		// file:line in backtraces at a fraction of it.
		"CARGO_PROFILE_DEV_DEBUG": "line-tables-only"
	},
	"mounts": [
		// Downloaded crates, shared by every project on this machine.
		{
			"source": "devcontainer-cargo-registry",
			"target": "/usr/local/cargo/registry",
			"type": "volume"
		},
		{
			"source": "devcontainer-cargo-git",
			"target": "/usr/local/cargo/git",
			"type": "volume"
		},
		// This project's Claude sessions, history and settings.
		{
			"source": "${localWorkspaceFolderBasename}-devcontainer-claude-config",
			"target": "/home/vscode/.claude",
			"type": "volume"
		},
		// Host git config, so name/email are set. SSH keys are not mounted: VS
		// Code forwards the host SSH agent into the container automatically.
		{
			"source": "${localEnv:HOME}/.gitconfig",
			"target": "/home/vscode/.gitconfig",
			"type": "bind"
		}
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"spencerwmiles.vscode-task-buttons"
			]
		}
	}
}
